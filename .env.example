# Generate a complete local file with: npm run admin:setup
ADMIN_USERNAME=admin
# Format: scrypt$<32 hexadecimal salt characters>$<128 hexadecimal hash characters>
ADMIN_PASSWORD_HASH=
# Random secret of at least 32 characters; never expose it as NEXT_PUBLIC_*
SESSION_SECRET=

# Vercel: connect a PRIVATE Blob store to populate this automatically.
# Keep this token server-only. Public stores are not supported.
BLOB_READ_WRITE_TOKEN=

# Optional exact origin, e.g. https://medcafe-one.vercel.app (normally auto-detected).
APP_ORIGIN=

# Only for a single-server production installation with a persistent disk.
# Do not use on Vercel. Local development defaults to .data/ automatically.
LOCAL_STORAGE_DIR=
